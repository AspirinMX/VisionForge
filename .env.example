# PostgreSQL (docker compose)
POSTGRES_DB=visionforge
POSTGRES_USER=visionforge
POSTGRES_PASSWORD=visionforge
POSTGRES_PORT=5432

# Backend applications
VISIONFORGE_DB_URL=jdbc:postgresql://localhost:5432/visionforge
VISIONFORGE_DB_USER=visionforge
VISIONFORGE_DB_PASSWORD=visionforge

# Redis (streaming deltas and future caches)
REDIS_HOST=localhost
REDIS_PORT=6379
STREAM_TIMEOUT_MS=300000

# Object storage (S3 compatible; RustFS by default)
STORAGE_BACKEND=s3
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=visionforge
STORAGE_ACCESS_KEY=rustfsadmin
STORAGE_SECRET_KEY=rustfsadmin
STORAGE_PATH_STYLE=true
STORAGE_PRESIGN_TTL=15m
STORAGE_UPLOAD_SESSION_TTL=1h
STORAGE_MAX_UPLOAD_BYTES=2147483648

# RustFS container credentials and bucket (docker compose)
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
RUSTFS_BUCKET=visionforge
RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# JWT signing secret (Base64, at least 32 bytes)
# Generate with: openssl rand -base64 32
JWT_SECRET=
BCRYPT_STRENGTH=12

# Encrypts provider API keys stored in model_definition (Base64, exactly 32 bytes)
# Generate with: openssl rand -base64 32
MODEL_CONFIG_SECRET=

# Media generation credit grant for a new account (smallest credit unit)
BILLING_INITIAL_CREDIT_UNITS=10000

# FFmpeg composition
FFMPEG_PATH=ffmpeg
COMPOSITION_PART_SIZE_BYTES=8388608
COMPOSITION_TIMEOUT=30m
COMPOSITION_PRESIGN_TTL=2h

# Temporal
TEMPORAL_TARGET=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=vision-forge

# Temporal worker runtime
WORKER_MAX_CONCURRENT_ACTIVITIES=20
WORKER_MAX_CONCURRENT_WORKFLOW_TASKS=20
WORKER_MAX_CONCURRENT_LOCAL_ACTIVITIES=20
WORKER_WORKFLOW_TASK_POLLERS=5
WORKER_ACTIVITY_TASK_POLLERS=5
WORKER_WORKFLOW_CACHE_SIZE=600
WORKER_MAX_WORKFLOW_THREADS=600
WORKER_GRACEFUL_SHUTDOWN_TIMEOUT=30s
WORKER_START_COMPENSATION_ENABLED=true
WORKER_START_COMPENSATION_INTERVAL_MS=5000
WORKER_START_COMPENSATION_BATCH_SIZE=20
WORKER_START_COMPENSATION_MAX_ATTEMPTS=20

# First administrator, created on startup when email and password are set
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_DISPLAY_NAME=Administrator
