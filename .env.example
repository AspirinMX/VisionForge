# PostgreSQL (docker compose)
POSTGRES_DB=visionforge
POSTGRES_USER=visionforge
POSTGRES_PASSWORD=visionforge
POSTGRES_PORT=5432

# Backend applications
VISIONFORGE_DB_URL=jdbc:postgresql://localhost:5432/visionforge
VISIONFORGE_DB_USER=visionforge
VISIONFORGE_DB_PASSWORD=visionforge

# JWT signing secret (Base64, at least 32 bytes)
# Generate with: openssl rand -base64 32
JWT_SECRET=
BCRYPT_STRENGTH=12

# Encrypts provider API keys stored in model_definition (Base64, exactly 32 bytes)
# Generate with: openssl rand -base64 32
MODEL_CONFIG_SECRET=

# Temporal
TEMPORAL_TARGET=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=vision-forge

# First administrator, created on startup when email and password are set
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_DISPLAY_NAME=Administrator
